{
  // Must match the Worker's name in the Cloudflare dashboard
  "name": "portfolio",
  "compatibility_date": "2026-11-01",
  // Serve every file in this repo as a static site
  "assets": {
    "directory": "./"
  },
  // Lets non-main branches build a preview link (npx wrangler preview)
  "previews": {}
}
